# Copy this file to .env.local and update it from Supabase Project Settings > API.
# Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only Nebius Token Factory configuration. Never add NEXT_PUBLIC_ to these.
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Optional pricing inputs used only for estimated-cost telemetry.
NEBIUS_INPUT_USD_PER_MILLION=
NEBIUS_OUTPUT_USD_PER_MILLION=

# Server-only Deepgram speech configuration. Never use NEXT_PUBLIC_ for this key.
DEEPGRAM_API_KEY=

# Athena resource discovery (server-only). No CLI OAuth token is used by the app.
TAVILY_API_KEY=
# Explicit opt-in for capped keyless development calls when no API key is set.
TAVILY_ALLOW_KEYLESS=false
# Keep the staged endpoint disabled until request disclosure and usage controls are ready.
ATHENA_DISCOVERY_ENABLED=false
